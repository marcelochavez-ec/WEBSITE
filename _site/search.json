    "text": "Operaciones básicas\n\n\nMostrar código\nimport pandas as pd\n\ndf_ipc = pd.read_excel(\"IPC/SERIE HISTORICA IPC_05_2025.xls\",\n                        sheet_name=\"2. VARIACIÓN MENSUAL\",\n                        skiprows=5,\n                        engine=\"xlrd\",\n                        nrows=57)\n# Lista con los nombres correctos de las columnas\nnuevos_nombres = [\"AÑOS\",\n                  \"ENERO\", \n                  \"FEBRERO\",\n                  \"MARZO\",\n                  \"ABRIL\",\n                  \"MAYO\",\n                  \"JUNIO\",\n                  \"JULIO\",\n                  \"AGOSTO\", \n                  \"SEPTIEMBRE\", \n                  \"OCTUBRE\",\n                  \"NOVIEMBRE\",\n                  \"DICIEMBRE\",\n                  \"PROMEDIO_MENSUAL\"]\n\n# Asignar los nuevos nombres al DataFrame\ndf_ipc.columns = nuevos_nombres\n\ndisplay(df_ipc)\nprint(\"TIPO DE VARIABLES:\")\ndf_ipc.dtypes\n\n\n\n\n\n\n\n\n\nAÑOS\nENERO\nFEBRERO\nMARZO\nABRIL\nMAYO\nJUNIO\nJULIO\nAGOSTO\nSEPTIEMBRE\nOCTUBRE\nNOVIEMBRE\nDICIEMBRE\nPROMEDIO_MENSUAL\n\n\n\n\n0\n1969\nNaN\n1.680196\n1.866132\n3.359616\n-3.841073\n-0.053425\n-0.881185\n0.445278\n0.493269\n0.169211\n-0.672223\n2.332545\n0.445304\n\n\n1\n1970\n-1.694896\n-0.283286\n1.704545\n-0.279330\n0.560224\n0.835655\n0.000000\n4.143646\n3.713528\n-0.255754\n1.282051\n0.506329\n0.852726\n\n\n2\n1971\n-0.251889\n-0.505050\n2.030457\n1.243781\n-0.737101\n-0.495049\n1.243781\n0.491400\n0.000000\n0.488998\n0.729927\n1.932367\n0.514302\n\n\n3\n1972\n0.236967\n1.418440\n1.398601\n-1.149425\n-0.465116\n2.570093\n0.911162\n-0.451467\n0.680272\n-0.675676\n0.907029\n0.224719\n0.467133\n\n\n4\n1973\n2.017937\n0.879121\n2.832244\n2.118644\n0.622407\n0.618557\n0.204918\n0.817996\n1.622718\n2.395210\n0.974659\n1.351351\n1.371313\n\n\n5\n1974\n1.714286\n3.558052\n5.786618\n4.957265\n-1.628665\n-1.158940\n0.000000\n1.675042\n2.306425\n0.000000\n3.059581\n0.312500\n1.715180\n\n\n6\n1975\n2.80373