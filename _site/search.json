E', 'NOVIEMBRE', 'DICIEMBRE']\n\n# 1. Convertir de ancho a largo\ndf_long = df_ipc.melt(id_vars='AÑOS', value_vars=meses,\n                  var_name='MES', value_name='VALOR')\n\n# 2. Crear un orden cronológico para los meses\norden_meses = {mes: i+1 for i, mes in enumerate(meses)}\ndf_long['MES_NUM'] = df_long['MES'].map(orden_meses)\n\n# 3. Ordenar por año y mes\ndf_long = df_long.sort_values(by=['AÑOS', 'MES_NUM']).reset_index(drop=True)\n\n# 4. Calcular variación absoluta y porcentual respecto al mes anterior\ndf_long['VARIACION'] = df_long['VALOR'].diff()\ndf_long['VARIACION_PORCENTUAL'] = df_long['VARIACION'] / df_long['VALOR'].shift(1) * 100\ndisplay(df_long)\n\n\n\n\n\n\n\n\n\nAÑOS\nMES\nVALOR\nMES_NUM\nVARIACION\nVARIACION_PORCENTUAL\n\n\n\n\n0\n1969\nENERO\nNaN\n1\nNaN\nNaN\n\n\n1\n1969\nFEBRERO\n1.680196\n2\nNaN\nNaN\n\n\n2\n1969\nMARZO\n1.866132\n3\n0.185936\n11.066345\n\n\n3\n1969\nABRIL\n3.359616\n4\n1.493484\n80.030964\n\n\n4\n1969\nMAYO\n-3.841073\n5\n-7.200689\n-214.330716\n\n\n...\n...\n...\n...\n...\n...\n...\n\n\n679\n2025\nAGOSTO\nNaN\n8\nNaN\nNaN\n\n\n680\n2025\nSEPTIEMBRE\nNaN\n9\nNaN\nNaN\n\n\n681\n2025\nOCTUBRE\nNaN\n10\nNaN\nNaN\n\n\n682\n2025\nNOVIEMBRE\nNaN\n11\nNaN\nNaN\n\n\n683\n2025\nDICIEMBRE\nNaN\n12\nNaN\nNaN\n\n\n\n\n684 rows × 6 columns"
