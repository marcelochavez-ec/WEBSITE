rue)\n\n# 4. Calcular variación absoluta y porcentual respecto al mes anterior\ndf_long['VARIACION'] = df_long['VALOR'].diff()\ndf_long['VARIACION_PORCENTUAL'] = df_long['VARIACION'] / df_long['VALOR'].shift(1) * 100\ndisplay(df_long)\n```\n\n::: {.cell-output .cell-output-display}\n```{=html}\n<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>AÑOS</th>\n      <th>MES</th>\n      <th>VALOR</th>\n      <th>MES_NUM</th>\n      <th>VARIACION</th>\n      <th>VARIACION_PORCENTUAL</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>1969</td>\n      <td>ENERO</td>\n      <td>NaN</td>\n      <td>1</td>\n      <td>NaN</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>1969</td>\n      <td>FEBRERO</td>\n      <td>1.680196</td>\n      <td>2</td>\n      <td>NaN</td>\n      <td>NaN</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>1969</td>\n      <td>MARZO</td>\n      <td>1.866132</td>\n      <td>3</td>\n      <td>0.185936</td>\n      <td>11.066345</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>1969</td>\n      <td>ABRIL</td>\n      <td>3.359616</td>\n      <td>4</td>\n      <td>1.493484</td>\n      <td>80.030964</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>1969</td>\n      <td>MAYO</td>\n      <td>-3.841073</td>\n      <td>5</td>\n      <td>-7.200689</td>\n      <td>-214.330716</td>\n    </tr>\n    <tr>\n      <th>...</th>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n      <td>...</td>\n    </tr>\n    <tr>\n      <th>679</th>\n      <td>2025</td>\n      <td>AGOSTO</td>\n      <td>NaN</td>\n      <td>8</td>\n      <td>NaN</td>\n      <td>N